0, 10);\n    return u;\n}\n\nstatic CombatSimulation Duel(ulong seed, Game.Data.Structs.SkillData hSkill,\n    Game.Data.Structs.SkillData eSkill,\n    Game.Data.Element hElem = Game.Data.Element.Neutral,\n    Game.Data.Element eElem = Game.Data.Element.Neutral,\n    float hStr = 10, float hCon = 10, float hInt = 10,\n    float eStr = 10, float eCon = 10, int hPoise = 30,\n    Game.Data.HeroClass hCls = Game.Data.HeroClass.Slayer)\n{\n    var sim = new CombatSimulation(seed);\n    var h = MkUnit(\"hero\", Game.Data.TeamSide.Player, hElem, hStr, hCon, hInt, hPoise, hCls);\n    h.Skills.Add(new SkillRuntime(hSkill, 0));\n    var e = MkUnit(\"enemy\", Game.Data.TeamSide.Enemy, eElem, eStr, eCon);\n    e.Skills.Add(new SkillRuntime(eSkill, 0));\n    sim.AddUnit(h);\n    sim.AddUnit(e, TestFactory.SimpleAi());\n    sim.Start();\n    return sim;\n}\n\nvar results = new List<string>();\n\n// S01\n{ var s = Duel(1001UL, Phys(), Phys()); s.RunToCompletion(); results.Add(\"S01=\" + s.Events.ToSignature()); }\n// S02\n{ var s = Duel(2002UL, Phys(), Phys()); s.RunToCompletion(); results.Add(\"S02=\" + s.Events.ToSignature()); }\n// S03\n{ var s = Duel(3003UL, Phys(Game.Data.Element.Fire), Phys(), Game.Data.Element.Fire, Game.Data.Element.Water); s.RunToCompletion(); results.Add(\"S03=\" + s.Events.ToSignature()); }\n// S04\n{ var s = Duel(4004UL, Phys(Game.Data.Element.Water), Phys(), Game.Data.Element.Water, Game.Data.Element.Fire); s.RunToCompletion(); results.Add(\"S04=\" + s.Events.ToSignature()); }\n// S05\n{ var s = Duel(5005UL, Phys(power: 0.4f, hits: 3), Phys()); s.RunToCompletion(); results.Add(\"S05=\" + s.Events.ToSignature()); }\n// S06\n{ var s = Duel(6006UL, Phys(power: 2.5f), Phys()); s.RunToCompletion(); results.Add(\"S06=\" + s.Events.ToSignature()); }\n// S07\n{ var s = Duel(7007UL, Phys(), Phys(), eStr: 25f); s.RunToCompletion(); results.Add(\"S07=\" + s.Events.ToSignature()); }\n// S08\n{ var s = Duel(8008UL, Phys(), Phys(), hCon: 30f); s.RunToCompletion(); 