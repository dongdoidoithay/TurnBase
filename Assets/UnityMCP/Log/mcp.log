{"ts":"2026-08-13T05:31:33.602Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":1087,"action":"execute","params":{"action":"execute","code":"\nFont font = Resources.GetBuiltinResource<Font>(\"LegacyRuntime.ttf\");\nSprite panelSprite = UnityEditor.AssetDatabase.LoadAssetAtPath<Sprite>(\"Assets/_Project/Art/UI/Frames/ui_rounded_panel.png\");\n\nFunc<GameObject, Vector2, Vector2, Vector2, Vector2, Vector2, RectTransform> MakeRT = (go, anchorMin, anchorMax, pivot, anchoredPos, sizeDelta) =>\n{\n    var rt = go.GetComponent<RectTransform>();\n    if (rt == null) rt = go.AddComponent<RectTransform>();\n    rt.anchorMin = anchorMin; rt.anchorMax = anchorMax; rt.pivot = pivot;\n    rt.anchoredPosition = anchoredPos; rt.sizeDelta = sizeDelta;\n    return rt;\n};\nFunc<GameObject, string, int, TextAnchor, Color, UnityEngine.UI.Text> MakeText = (go, content, fontSize, align, color) =>\n{\n    var t = go.AddComponent<UnityEngine.UI.Text>();\n    t.font = font; t.fontSize = fontSize; t.alignment = align; t.color = color;\n    t.text = content;\n    t.horizontalOverflow = HorizontalWrapMode.Wrap;\n    t.verticalOverflow = VerticalWrapMode.Truncate;\n    return t;\n};\nFunc<GameObject, Color, UnityEngine.UI.Image> MakePanelImage = (go, tint) =>\n{\n    var img = go.AddComponent<UnityEngine.UI.Image>();\n    img.sprite = panelSprite; img.type = UnityEngine.UI.Image.Type.Sliced; img.color = tint;\n    return img;\n};\n\nvar root = new GameObject(\"UI_HeroDetail\", typeof(RectTransform));\nvar canvas = root.AddComponent<Canvas>();\ncanvas.renderMode = RenderMode.ScreenSpaceOverlay;\ncanvas.sortingOrder = 300;\nvar scaler = root.AddComponent<UnityEngine.UI.CanvasScaler>();\nscaler.uiScaleMode = UnityEngine.UI.CanvasScaler.ScaleMode.ScaleWithScreenSize;\nscaler.referenceResolution = new Vector2(960, 540);\nscaler.matchWidthOrHeight = 0.5f;\nroot.AddComponent<UnityEngine.UI.GraphicRaycaster>();\n\nvar dim = new GameObject(\"Dim\", typeof(RectTransform));\ndim.transform.SetParent(root.transform, false);\nMakeRT(dim, Vector2.zero, Vector2.one, new Vector2(0.5f,0.5f), Vector2.zero, Vector2.zero);\ndim.AddComponent<UnityEngine.UI.Image>().color = new Color(0,0,0,0.65f);\n\nvar panel = new GameObject(\"Panel\", typeof(RectTransform));\npanel.transform.SetParent(root.transform, false);\nMakeRT(panel, new Vector2(0.5f,0.5f), new Vector2(0.5f,0.5f), new Vector2(0.5f,0.5f), Vector2.zero, new Vector2(680,460));\nMakePanelImage(panel, new Color(0.647f,0.365f,0.898f,0.95f));\n\nvar fill = new GameObject(\"Fill\", typeof(RectTransform));\nfill.transform.SetParent(panel.transform, false);\nMakeRT(fill, Vector2.zero, Vector2.one, new Vector2(0.5f,0.5f), Vector2.zero, new Vector2(-24,-24));\nMakePanelImage(fill, new Color(0.114f,0.078f,0.129f,0.98f));\n\nvar title = new GameObject(\"Title\", typeof(RectTransform));\ntitle.transform.SetParent(panel.transform, false);\nMakeRT(title, new Vector2(0.5f,1f), new Vector2(0.5f,1f), new Vector2(0.5f,1f), new Vector2(0,-16), new Vector2(500,30));\nMakeText(title, \"HERO\", 20, TextAnchor.MiddleCenter, new Color(1f,0.85f,0.5f,1f));\n\n// Portrait (frame > mask > sprite)\nvar portraitFrame = new GameObject(\"PortraitFrame\", typeof(RectTransform));\nportraitFrame.transform.SetParent(panel.transform, false);\nMakeRT(portraitFrame, new Vector2(0,1), new Vector2(0,1), new Vector2(0,1), new Vector2(24,-56), new Vector2(140,140));\nMakePanelImage(portraitFrame, Color.white);\nvar portraitMask = new GameObject(\"PortraitMask\", typeof(RectTransform));\nportraitMask.transform.SetParent(portraitFrame.transform, false);\nMakeRT(portraitMask, Vector2.zero, Vector2.one, new Vector2(0.5f,0.5f), Vector2.zero, new Vector2(-8,-8));\nportraitMask.AddComponent<UnityEngine.UI.Image>().color = new Color(1,1,1,0);\nportraitMask.AddComponent<UnityEngine.UI.Mask>().showMaskGraphic = false;\nvar portraitSprite = new GameObject(\"PortraitSprite\", typeof(RectTransform));\nportraitSprite.transform.SetParent(portraitMask.transform, false);\nMakeRT(portraitSprite, Vector2.zero, Vector2.one, new Vector2(0.5f,0.5f), Vector2.zero, Vector2.zero);\nportraitSprite.AddComponent<UnityEngine.UI.Image>().preserveAspect = true;\n\nvar levelLabel = new GameObject(\"LevelLabel\", typeof(RectTransform));\nlevelLabel.transform.SetParent(panel.transform, false);\nMakeRT(levelLabel, new Vector2(0,1), new Vector2(0,1), new Vector2(0,1), new Vector2(24,-206), new Vector2(140,24));\nMakeText(levelLabel, \"Lv 1\", 14, TextAnchor.MiddleCenter, Color.white);\n\n// ExpBar (bg > Fill filled-image + ExpLabel overlay)\nvar expBar = new GameObject(\"ExpBar\", typeof(RectTransform));\nexpBar.transform.SetParent(panel.transform, false);\nMakeRT(expBar, new Vector2(0,1), new Vector2(0,1), new Vector2(0,1), new Vector2(24,-236), new Vector2(140,18));\nMakePanelImage(expBar, new Color(0.2f,0.2f,0.25f,1f));\nvar expFillGo = new GameObject(\"Fill\", typeof(RectTransform));\nexpFillGo.transform.SetParent(expBar.transform, false);\nMakeRT(expFillGo, Vector2.zero, Vector2.one, new Vector2(0f,0.5f), Vector2.zero, Vector2.zero);\nvar expFillImg = expFillGo.AddComponent<UnityEngine.UI.Image>();\nexpFillImg.color = new Color(0.3f,0.7f,1f,1f);\nexpFillImg.type = UnityEngine.UI.Image.Type.Filled;\nexpFillImg.fillMethod = UnityEngine.UI.Image.FillMethod.Horizontal;\nexpFillImg.fillAmount = 0.5f;\nvar expLabelGo = new GameObject(\"ExpLabel\", typeof(RectTransform));\nexpLabelGo.transform.SetParent(expBar.transform, false);\nMakeRT(expLabelGo, Vector2.zero, Vector2.one, new Vector2(0.5f,0.5f), Vector2.zero, Vector2.zero);\nMakeText(expLabelGo, \"0/0 EXP\", 9, TextAnchor.MiddleCenter, Color.white);\n\n// StatsContainer — 6 rows, 2 col x 3 row layout\nstring[] stats = { \"STR\", \"CON\", \"INT\", \"DEX\", \"AUR\", \"LUK\" };\nvar statsContainer = new GameObject(\"StatsContainer\", typeof(RectTransform));\nstatsContainer.transform.SetParent(panel.transform, false);\nMakeRT(statsContainer, new Vector2(0,1), new Vector2(0,1), new Vector2(0,1), new Vector2(24,-266), new Vector2(200,110));\nfor (int i = 0; i < stats.Length; i++)\n{\n    int col = i / 3, rowIdx = i % 3;\n    var row = new GameObject(\"Row_\" + stats[i], typeof(RectTransform));\n    row.transform.SetParent(statsContainer.transform, false);\n    MakeRT(row, new Vector2(0,1), new Vector2(0,1), new Vector2(0,1), new Vector2(col*100, -rowIdx*30f), new Vector2(96,26));\n    var lbl = new GameObject(\"Label\", typeof(RectTransform));\n    lbl.transform.SetParent(row.transform, false);\n    MakeRT(lbl, new Vector2(0,0.5f), new Vector2(0,0.5f), new Vector2(0,0.5f), new Vector2(0,0), new Vector2(40,24));\n    MakeText(lbl, stats[i], 11, TextAnchor.MiddleLeft, new Color(0.85f,0.8f,0.85f,1f));\n    var val = new GameObject(\"Value\", typeof(RectTransform));\n    val.transform.SetParent(row.transform, false);\n    MakeRT(val, new Vector2(0,0.5f), new Vector2(0,0.5f), new Vector2(0,0.5f), new Vector2(44,0), new Vector2(48,24));\n    MakeText(val, \"0\", 12, TextAnchor.MiddleLeft, Color.white);\n}\n\n// SkillListContainer — 5 rows on the right side\nvar skillList = new GameObject(\"SkillListContainer\", typeof(RectTransform));\nskillList.transform.SetParent(panel.transform, false);\nMakeRT(skillList, new Vector2(0,1), new Vector2(0,1), new Vector2(0,1), new Vector2(250,-56), new Vector2(400,260));\nfor (int i = 0; i < 5; i++)\n{\n    var row = new GameObject(\"Row_\" + i, typeof(RectTransform));\n    row.transform.SetParent(skillList.transform, false);\n    MakeRT(row, new Vector2(0,1), new Vector2(0,1), new Vector2(0,1), new Vector2(0, -50f*i), new Vector2(400,46));\n    MakePanelImage(row, new Color(0.2f,0.2f,0.28f,0.6f));\n\n    var nameGo = new GameObject(\"NameLabel\", typeof(RectTransform));\n    nameGo.transform.SetParent(row.transform, false);\n    MakeRT(nameGo, new Vector2(0,0.5f), new Vector2(0,0.5f), new Vector2(0,0.5f), new Vector2(8,6), new Vector2(220,20));\n    MakeText(nameGo, \"Skill\", 12, TextAnchor.MiddleLeft, Color.white);\n\n    var lvlGo = new GameObject(\"LevelLabel\", typeof(RectTransform));\n    lvlGo.transform.SetParent(row.transform, false);\n    MakeRT(lvlGo, new Vector2(0,0.5f), new Vector2(0,0.5f), new Vector2(0,0.5f), new Vector2(8,-14), new Vector2(220,16));\n    MakeText(lvlGo, \"Lv 1\", 10, TextAnchor.MiddleLeft, new Color(0.85f,0.8f,0.85f,1f));\n\n    var upBtn = new GameObject(\"UpgradeButton\", typeof(RectTransform));\n    upBtn.transform.SetParent(row.transform, false);\n    MakeRT(upBtn, new Vector2(1,0.5f), new Vector2(1,0.5f), new Vector2(1,0.5f), new Vector2(-6,0), new Vector2(90,34));\n    MakePanelImage(upBtn, new Color(0.271f,0.482f,0.616f,0.95f));\n    upBtn.AddComponent<UnityEngine.UI.Button>();\n    var upLabelGo = new GameObject(\"Label\", typeof(RectTransform));\n    upLabelGo.transform.SetParent(upBtn.transform, false);\n    MakeRT(upLabelGo, Vector2.zero, Vector2.one, new Vector2(0.5f,0.5f), Vector2.zero, Vector2.zero);\n    MakeText(upLabelGo, \"+0g\", 10, TextAnchor.MiddleCenter, Color.white);\n}\n\n// AscendButton\nvar ascend = new GameObject(\"AscendButton\", typeof(RectTransform));\nascend.transform.SetParent(panel.transform, false);\nMakeRT(ascend, new Vector2(0,0f), new Vector2(0,0f), new Vector2(0,0f), new Vector2(24,20), new Vector2(200,54));\nMakePanelImage(ascend, new Color(0.647f,0.365f,0.898f,0.95f));\nascend.AddComponent<UnityEngine.UI.Button>();\nvar ascendLabel = new GameObject(\"Label\", typeof(RectTransform));\nascendLabel.transform.SetParent(ascend.transform, false);\nMakeRT(ascendLabel, Vector2.zero, Vector2.one, new Vector2(0.5f,0.5f), Vector2.zero, Vector2.zero);\nvar ascendTxt = MakeText(ascendLabel, \"ASCEND\", 12, TextAnchor.MiddleCenter, Color.white);\nascendTxt.verticalOverflow = VerticalWrapMode.Overflow;\n\nvar close = new GameObject(\"CloseButton\", typeof(RectTransform));\nclose.transform.SetParent(panel.transform, false);\nMakeRT(close, new Vector2(0.5f,0f), new Vector2(0.5f,0f), new Vector2(0.5f,0f), new Vector2(120,20), new Vector2(140,36));\nMakePanelImage(close, new Color(0.32f,0.29f,0.33f,1f));\nclose.AddComponent<UnityEngine.UI.Button>();\nvar closeLabel = new GameObject(\"Label\", typeof(RectTransform));\ncloseLabel.transform.SetParent(close.transform, false);\nMakeRT(closeLabel, Vector2.zero, Vector2.one, new Vector2(0.5f,0.5f), Vector2.zero, Vector2.zero);\nMakeText(closeLabel, \"CLOSE\", 14, TextAnchor.MiddleCenter, Color.white);\n\nUnityEditor.PrefabUtility.SaveAsPrefabAsset(root, \"Assets/_Project/Resources/Prefabs/UI/Screens/UI_HeroDetail.prefab\");\nUnityEngine.Object.DestroyImmediate(root);\nreturn \"UI_HeroDetail saved\";\n","safety_checks":true,"compiler":"auto"}}
