eated: \" + (tutorial != null));\n    results.AppendLine(\"initial Step: \" + tutorial.Step);\n    results.AppendLine(\"overlay active after WireTutorial: \" + overlayGo.activeSelf);\n\n    tutorial.NotifySkillChosen();\n    results.AppendLine(\"after NotifySkillChosen: \" + tutorial.Step);\n\n    tutorial.Skip();\n    results.AppendLine(\"after Skip: \" + tutorial.Step);\n    results.AppendLine(\"overlay active after Done: \" + overlayGo.activeSelf);\n    results.AppendLine(\"profile.Progress.TutorialCompleted (after) = \" +\n        Game.Services.Save.ProfileContext.Current.Progress.TutorialCompleted);\n}\nfinally\n{\n    UnityEngine.Object.DestroyImmediate(installerGo);\n    UnityEngine.Object.DestroyImmediate(overlayGo);\n    Game.Services.Save.ProfileContext.Current = null;\n}\n\nreturn results.ToString();","safety_checks":true,"compiler":"auto"}}
