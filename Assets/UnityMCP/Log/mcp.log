{"ts":"2026-08-13T06:37:19.818Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":1005,"action":"execute","params":{"action":"execute","code":"\nif (UnityEngine.Application.isPlaying) return \"STILL PLAYING - abort\";\n\nFont font = Resources.GetBuiltinResource<Font>(\"LegacyRuntime.ttf\");\nSprite panelSprite = UnityEditor.AssetDatabase.LoadAssetAtPath<Sprite>(\"Assets/_Project/Art/UI/Frames/ui_rounded_panel.png\");\n\nvar topBar = GameObject.Find(\"TopBar\");\nif (topBar == null) return \"TopBar not found\";\nif (topBar.scene.name != \"Boot\") return \"TopBar found but in wrong scene: \" + topBar.scene.name;\n\nFunc<GameObject, Vector2, Vector2, Vector2, Vector2, Vector2, RectTransform> MakeRT = (go, anchorMin, anchorMax, pivot, anchoredPos, sizeDelta) =>\n{\n    var rt = go.GetComponent<RectTransform>();\n    if (rt == null) rt = go.AddComponent<RectTransform>();\n    rt.anchorMin = anchorMin; rt.anchorMax = anchorMax; rt.pivot = pivot;\n    rt.anchoredPosition = anchoredPos; rt.sizeDelta = sizeDelta;\n    return rt;\n};\n\n// Nút TopBar chuẩn — Image (bronze panel, tint vàng gốc) + Button + Label con.\n// Toạ độ/kích thước lấy ĐÚNG số liệu đã đo bằng execute_code TRƯỚC khi sự cố xảy ra (đầu phiên).\nFunc<string, float, float, int, string, GameObject> MakeNavButton = (name, x, w, fontSize, label) =>\n{\n    var go = new GameObject(name, typeof(RectTransform));\n    go.transform.SetParent(topBar.transform, false);\n    MakeRT(go, new Vector2(1,0.5f), new Vector2(1,0.5f), new Vector2(1,0.5f), new Vector2(x,0), new Vector2(w,44));\n    var img = go.AddComponent<UnityEngine.UI.Image>();\n    img.sprite = panelSprite; img.type = UnityEngine.UI.Image.Type.Sliced;\n    img.color = new Color(0.949f, 0.710f, 0.204f, 0.95f);\n    go.AddComponent<UnityEngine.UI.Button>();\n    var labelGo = new GameObject(\"Label\", typeof(RectTransform));\n    labelGo.transform.SetParent(go.transform, false);\n    MakeRT(labelGo, Vector2.zero, Vector2.one, new Vector2(0.5f,0.5f), Vector2.zero, Vector2.zero);\n    var t = labelGo.AddComponent<UnityEngine.UI.Text>();\n    t.font = font; t.fontSize = fontSize; t.alignment = TextAnchor.MiddleCenter; t.color = Color.white;\n    t.text = label;\n    t.horizontalOverflow = HorizontalWrapMode.Overflow;\n    t.verticalOverflow = VerticalWrapMode.Truncate;\n    return go;\n};\n\nvar sb = new System.Text.StringBuilder();\nvar summon = MakeNavButton(\"SummonButton\", -150f, 110f, 18, \"SUMMON\");\nsummon.GetComponent<UnityEngine.UI.Image>().color = new Color(0.647f,0.365f,0.898f,0.95f); // gốc: SUMMON nổi bật riêng (tím)\nsb.AppendLine(\"SummonButton added\");\n\nMakeNavButton(\"QuestButton\", -270f, 110f, 13, \"QUEST\");\nsb.AppendLine(\"QuestButton added\");\n\nMakeNavButton(\"DungeonButton\", -580f, 90f, 11, \"DUNGEON\");\nsb.AppendLine(\"DungeonButton added\");\n\nMakeNavButton(\"TrialBossButton\", -680f, 90f, 11, \"TRIAL\");\nsb.AppendLine(\"TrialBossButton added\");\n\nMakeNavButton(\"TowerButton\", -780f, 90f, 11, \"TOWER\");\nsb.AppendLine(\"TowerButton added\");\n\nvar mail = MakeNavButton(\"MailButton\", -430f, 90f, 11, \"MAIL\");\nsb.AppendLine(\"MailButton added\");\n\nMakeNavButton(\"CodexButton\", -505f, 50f, 9, \"CODEX\");\nsb.AppendLine(\"CodexButton added\");\n\nMakeNavButton(\"InventoryButton\", -361f, 90f, 11, \"ITEMS\");\nsb.AppendLine(\"InventoryButton added\");\n\n// MailBadge > BadgeLabel — badge số mail chưa claim, góc trên-phải MailButton, mặc định ẩn.\nvar badge = new GameObject(\"MailBadge\", typeof(RectTransform));\nbadge.transform.SetParent(mail.transform, false);\nMakeRT(badge, new Vector2(1,1), new Vector2(1,1), new Vector2(1,1), new Vector2(-2,-2), new Vector2(20,20));\nvar badgeImg = badge.AddComponent<UnityEngine.UI.Image>();\nbadgeImg.color = new Color(0.9f,0.2f,0.2f,1f);\nvar badgeLabelGo = new GameObject(\"BadgeLabel\", typeof(RectTransform));\nbadgeLabelGo.transform.SetParent(badge.transform, false);\nMakeRT(badgeLabelGo, Vector2.zero, Vector2.one, new Vector2(0.5f,0.5f), Vector2.zero, Vector2.zero);\nvar badgeTxt = badgeLabelGo.AddComponent<UnityEngine.UI.Text>();\nbadgeTxt.font = font; badgeTxt.fontSize = 11; badgeTxt.alignment = TextAnchor.MiddleCenter; badgeTxt.color = Color.white;\nbadgeTxt.text = \"0\";\nbadge.SetActive(false);\nsb.AppendLine(\"MailBadge/BadgeLabel added\");\n\nreturn sb.ToString();\n","safety_checks":true,"compiler":"auto"}}
