{"ts":"2026-08-12T10:25:55.368Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":1101,"action":"execute","params":{"action":"execute","code":"var font = UnityEditor.AssetDatabase.LoadAssetAtPath<TMPro.TMP_FontAsset>(\n    \"Assets/TextMesh Pro/Resources/Fonts & Materials/LiberationSans SDF.asset\");\n\nvar canvasGo = new GameObject(\"VerifyCanvas\");\nvar textGo = new GameObject(\"VerifyText\");\ntry\n{\n    var canvas = canvasGo.AddComponent<Canvas>();\n    textGo.transform.SetParent(canvasGo.transform, false);\n    var tmp = textGo.AddComponent<TMPro.TextMeshProUGUI>();\n    tmp.font = font;\n    tmp.text = \"ảạăắằẳẵặấầẩẫậđẻẹếềểễệỉĩịỏọốồổỗộơớờởỡợủũụưứừửữựỳỷỹỵẢẠĐ\";\n    tmp.ForceMeshUpdate();\n\n    var info = tmp.textInfo;\n    int withElement = 0, noElement = 0;\n    var missing = new System.Text.StringBuilder();\n    for (int i = 0; i < info.characterCount; i++)\n    {\n        var ci = info.characterInfo[i];\n        if (ci.textElement != null) withElement++;\n        else { noElement++; missing.Append(ci.character); }\n    }\n    return \"charCount=\" + info.characterCount + \" withElement=\" + withElement + \" noElement=\" + noElement +\n           \" missingChars='\" + missing.ToString() + \"'\";\n}\nfinally\n{\n    UnityEngine.Object.DestroyImmediate(textGo);\n    UnityEngine.Object.DestroyImmediate(canvasGo);\n}","safety_checks":true,"compiler":"auto"}}
