{"ts":"2026-08-11T16:15:46.410Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":947,"action":"execute","params":{"action":"execute","code":"\nvar canvasGo = new GameObject(\"TmpCanvas\", typeof(RectTransform), typeof(Canvas));\nvar screenGo = new GameObject(\"TmpScreen\", typeof(RectTransform));\nscreenGo.transform.SetParent(canvasGo.transform, false);\nvar screen = screenGo.AddComponent<Game.Meta.TeamSelectScreen>();\n\nvar mi = typeof(Game.Meta.TeamSelectScreen).GetMethod(\"BuildShell\", System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance);\nmi.Invoke(screen, null);\n\nvar root = screenGo.transform.Find(\"UI_TeamSelect(Clone)\");\nvar content = (RectTransform)root.Find(\"Panel/Content\");\nvar footer = root.Find(\"Panel/Content/Footer\");\nvar formationRow = (RectTransform)content.Find(\"FormationRow\");\nvar startBtn = (RectTransform)footer.Find(\"StartButton\");\nvar backBtn = (RectTransform)footer.Find(\"BackButton\");\nvar selLabel = (RectTransform)footer.Find(\"SelectedLabel\");\n\nvar frBounds = RectTransformUtility.CalculateRelativeRectTransformBounds(content, formationRow);\nvar sbBounds = RectTransformUtility.CalculateRelativeRectTransformBounds(content, startBtn);\nvar bbBounds = RectTransformUtility.CalculateRelativeRectTransformBounds(content, backBtn);\nvar slBounds = RectTransformUtility.CalculateRelativeRectTransformBounds(content, selLabel);\n\nbool overlapStart = !(frBounds.min.y >= sbBounds.max.y || frBounds.max.y <= sbBounds.min.y);\nbool overlapBack = !(frBounds.min.y >= bbBounds.max.y || frBounds.max.y <= bbBounds.min.y);\nbool overlapSel = !(frBounds.min.y >= slBounds.max.y || frBounds.max.y <= slBounds.min.y);\n\nstring result =\n  \"FormationRow Y (content-local): \" + frBounds.min.y.ToString(\"F1\") + \" .. \" + frBounds.max.y.ToString(\"F1\") + \"\\n\" +\n  \"StartButton  Y (content-local): \" + sbBounds.min.y.ToString(\"F1\") + \" .. \" + sbBounds.max.y.ToString(\"F1\") + \"\\n\" +\n  \"BackButton   Y (content-local): \" + bbBounds.min.y.ToString(\"F1\") + \" .. \" + bbBounds.max.y.ToString(\"F1\") + \"\\n\" +\n  \"SelectedLbl  Y (content-local): \" + slBounds.min.y.ToString(\"F1\") + \" .. \" + slBounds.max.y.ToString(\"F1\") + \"\\n\" +\n  \"Overlap FormationRow/StartButton? \" + overlapStart + \"\\n\" +\n  \"Overlap FormationRow/BackButton?  \" + overlapBack + \"\\n\" +\n  \"Overlap FormationRow/SelectedLbl? \" + overlapSel;\n\nUnityEngine.Object.DestroyImmediate(canvasGo);\nreturn result;\n","safety_checks":true,"compiler":"auto"}}
