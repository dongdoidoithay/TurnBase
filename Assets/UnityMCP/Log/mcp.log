{"ts":"2026-08-12T10:25:04.345Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":979,"action":"execute","params":{"action":"execute","code":"var methods = typeof(TMPro.TMP_FontAsset).GetMethods(System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.Static);\nvar sb = new System.Text.StringBuilder();\nforeach (var m in methods)\n    if (m.Name == \"CreateFontAsset\")\n    {\n        sb.Append(\"CreateFontAsset(\");\n        foreach (var p in m.GetParameters()) sb.Append(p.ParameterType.Name + \" \" + p.Name + \", \");\n        sb.AppendLine(\")\");\n    }\nreturn sb.ToString();","safety_checks":true,"compiler":"auto"}}
