{"ts":"2026-08-12T10:25:40.059Z","tool":"execute_code","type":"tool","status":"ERROR","ms":994,"action":"execute","params":{"action":"execute","code":"var font = UnityEditor.AssetDatabase.LoadAssetAtPath<TMPro.TMP_FontAsset>(\n    \"Assets/TextMesh Pro/Resources/Fonts & Materials/LiberationSans SDF.asset\");\n\nvar canvasGo = new GameObject(\"VerifyCanvas\");\nvar textGo = new GameObject(\"VerifyText\");\ntry\n{\n    var canvas = canvasGo.AddComponent<Canvas>();\n    textGo.transform.SetParent(canvasGo.transform, false);\n    var tmp = textGo.AddComponent<TMPro.TextMeshProUGUI>();\n    tmp.font = font;\n    tmp.text = \"ảạăắằẳẵặấầẩẫậđẻẹếềểễệỉĩịỏọốồổỗộơớờởỡợủũụưứừửữựỳỷỹỵẢẠĐ\";\n    tmp.ForceMeshUpdate();\n\n    var info = tmp.textInfo;\n    int visibleWithGlyph = 0, visibleNoGlyph = 0;\n    for (int i = 0; i < info.characterCount; i++)\n    {\n        var ci = info.characterInfo[i];\n        if (!ci.isVisible) continue;\n        if (ci.glyph != null && ci.glyph.index != 0) visibleWithGlyph++;\n        else visibleNoGlyph++;\n    }\n    return \"charCount=\" + info.characterCount + \" withGlyph=\" + visibleWithGlyph + \" noGlyph(tofu)=\" + visibleNoGlyph +\n           \" fontHasCharNow('ả')=\" + font.HasCharacter('ả', false);\n}\nfinally\n{\n    UnityEngine.Object.DestroyImmediate(textGo);\n    UnityEngine.Object.DestroyImmediate(canvasGo);\n}","safety_checks":true,"compiler":"auto"},"error":"Compilation failed"}
