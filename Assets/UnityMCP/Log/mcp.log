{"ts":"2026-08-11T12:06:06.306Z","tool":"execute_code","type":"tool","status":"ERROR","ms":894,"action":"execute","params":{"action":"execute","code":"\nusing Game.Combat;\nusing Game.Combat.Model;\nusing Game.Data;\nusing Game.Tests;\nusing System.Collections.Generic;\nusing System.Text;\n\n// Helper: build sim tổng quát, trả về (result, turnCount, signature)\n(string label, string result, int turns, string sig) Run(string label, CombatSimulation sim)\n{\n    var r = sim.RunToCompletion();\n    return (label, r.ToString(), sim.State.TurnCounter, sim.Events.ToSignature());\n}\n\nvar results = new List<(string label, string result, int turns, string sig)>();\n\n// --- Scenario helpers (tái dùng hàm TestFactory) ---\nSkillData BasicAttack(Element elem = Element.Neutral, float power = 1.0f, int hits = 1, TargetMode target = TargetMode.SingleEnemy, int spCost = 0)\n    => new SkillData { Id = \"s\", Type = SkillType.Physical, DamageType = DamageType.Physical, Element = elem, Target = target, PowerMultiplier = power, HitCount = hits, SpCost = spCost, PoiseDamage = 3, CommandType = ActionCommandType.SingleTap, Applies = System.Array.Empty<StatusApplication>() };\n\nSkillData MagicAttack(Element elem = Element.Neutral, float power = 1.2f)\n    => new SkillData { Id = \"sm\", Type = SkillType.Magical, DamageType = DamageType.Magical, Element = elem, Target = TargetMode.SingleEnemy, PowerMultiplier = power, HitCount = 1, PoiseDamage = 2, CommandType = ActionCommandType.SingleTap, Applies = System.Array.Empty<StatusApplication>() };\n\nSkillData HealSkill(float healPower = 1.4f)\n    => new SkillData { Id = \"sh\", Type = SkillType.Heal, DamageType = DamageType.Magical, Target = TargetMode.LowestHpAlly, HealPower = healPower, CommandType = ActionCommandType.SingleTap, Applies = System.Array.Empty<StatusApplication>() };\n\nCombatUnit MakeUnit(string id, TeamSide side, Row row = Row.Front, Element elem = Element.Neutral, float str = 10, float con = 10, int poiseMax = 30, HeroClass cls = HeroClass.Slayer)\n{\n    var u = new CombatUnit { DefId = id, DisplayNameKey = id, Side = side, Row = row, Element = elem, Class = cls, PoiseMax = poiseMax };\n    u.BasePrimary = TestFactory.Stats(str: str, con: con);\n    return u;\n}\n\nCombatSimulation Duel(string heroId, string enemyId, SkillData heroSkill, SkillData enemySkill, ulong seed, float heroStr = 10, float heroCon = 10, float enemyStr = 10, float enemyCon = 10, Element heroElem = Element.Neutral, Element enemyElem = Element.Neutral, int heroPoiseMax = 30, int enemyPoiseMax = 30, Row heroRow = Row.Front, Row enemyRow = Row.Front)\n{\n    var sim = new CombatSimulation(seed);\n    var hero = MakeUnit(heroId, TeamSide.Player, heroRow, heroElem, heroStr, heroCon, heroPoiseMax);\n    hero.Skills.Add(new SkillRuntime(heroSkill, 0));\n    var enemy = MakeUnit(enemyId, TeamSide.Enemy, enemyRow, enemyElem, enemyStr, enemyCon, enemyPoiseMax);\n    enemy.Skills.Add(new SkillRuntime(enemySkill, 0));\n    sim.AddUnit(hero);\n    sim.AddUnit(enemy, TestFactory.SimpleAi());\n    sim.Start();\n    return sim;\n}\n\n// S01 — Duel chuẩn, neutral vs neutral, seed 1001\nresults.Add(Run(\"S01_Duel_Neutral_Seed1001\", Duel(\"hero\", \"enemy\", BasicAttack(), BasicAttack(), 1001UL)));\n\n// S02 — Duel chuẩn, seed 2002\nresults.Add(Run(\"S02_Duel_Neutral_Seed2002\", Duel(\"hero\", \"enemy\", BasicAttack(), BasicAttack(), 2002UL)));\n\n// S03 — Fire vs Water (hero có lợi element)\nresults.Add(Run(\"S03_Duel_Fire_vs_Water\", Duel(\"hero\", \"enemy\", BasicAttack(Element.Fire), BasicAttack(Element.Water), 3003UL, heroElem: Element.Fire, enemyElem: Element.Water)));\n\n// S04 — Water vs Fire (hero bất lợi element)\nresults.Add(Run(\"S04_Duel_Water_vs_Fire\", Duel(\"hero\", \"enemy\", BasicAttack(Element.Water), BasicAttack(Element.Fire), 4004UL, heroElem: Element.Water, enemyElem: Element.Fire)));\n\n// S05 — Hero có HealSkill, enemy tấn công thường\nresults.Add(Run(\"S05_Duel_HeroWithHeal\", Duel(\"hero\", \"enemy\", HealSkill(), BasicAttack(), 5005UL)));\n\n// S06 — Hero có multi-hit (3 lần)\nresults.Add(Run(\"S06_Duel_MultiHit3\", Duel(\"hero\", \"enemy\", BasicAttack(hits: 3, power: 0.4f), BasicAttack(), 6006UL)));\n\n// S07 — Hero có power cao (x2.5)\nresults.Add(Run(\"S07_Duel_HighPower\", Duel(\"hero\", \"enemy\", BasicAttack(power: 2.5f), BasicAttack(), 7007UL)));\n\n// S08 — Enemy mạnh hơn nhiều (str=25)\nresults.Add(Run(\"S08_Duel_StrongEnemy\", Duel(\"hero\", \"enemy\", BasicAttack(), BasicAttack(), 8008UL, enemyStr: 25f)));\n\n// S09 — Hero con cao (tanky, con=30)\nresults.Add(Run(\"S09_Duel_TankyHero\", Duel(\"hero\", \"enemy\", BasicAttack(), BasicAttack(), 9009UL, heroCon: 30f)));\n\n// S10 — Hero poise thấp (poiseMax=5, dễ Break)\nresults.Add(Run(\"S10_Duel_LowPoiseHero\", Duel(\"hero\", \"enemy\", BasicAttack(), BasicAttack(), 1010UL, heroPoiseMax: 5)));\n\n// S11 — TeamBattle 4v4 seed 2001\n{\n    var sim = TestFactory.TeamBattle(out _, out _, seed: 2001UL);\n    results.Add(Run(\"S11_Team4v4_Seed2001\", sim));\n}\n\n// S12 — TeamBattle 4v4 seed 3001\n{\n    var sim = TestFactory.TeamBattle(out _, out _, seed: 3001UL);\n    results.Add(Run(\"S12_Team4v4_Seed3001\", sim));\n}\n\n// S13 — Magical attack (hero dùng magic)\nresults.Add(Run(\"S13_Duel_MagicAttack\", Duel(\"hero\", \"enemy\", MagicAttack(Element.Neutral), BasicAttack(), 1313UL)));\n\n// S14 — Neutral vs Earth (earth resist neutral)\nresults.Add(Run(\"S14_Duel_Neutral_vs_Earth\", Duel(\"hero\", \"enemy\", BasicAttack(Element.Neutral), BasicAttack(Element.Earth), 1414UL, heroElem: Element.Neutral, enemyElem: Element.Earth)));\n\n// S15 — Duel seed 1515 hero có Int cao (magical INT=25)\n{\n    var sim = new CombatSimulation(1515UL);\n    var hero = new CombatUnit { DefId = \"hero\", DisplayNameKey = \"hero\", Side = TeamSide.Player, Row = Row.Front, Element = Element.Neutral, Class = HeroClass.Mage, PoiseMax = 30 };\n    hero.BasePrimary = TestFactory.Stats(@int: 25f);\n    hero.Skills.Add(new SkillRuntime(MagicAttack(power: 1.5f), 0));\n    var enemy = new CombatUnit { DefId = \"enemy\", DisplayNameKey = \"enemy\", Side = TeamSide.Enemy, Row = Row.Front, Element = Element.Neutral, Class = HeroClass.Slayer, PoiseMax = 30 };\n    enemy.BasePrimary = TestFactory.Stats(con: 15f);\n    enemy.Skills.Add(new SkillRuntime(BasicAttack(), 0));\n    sim.AddUnit(hero);\n    sim.AddUnit(enemy, TestFactory.SimpleAi());\n    sim.Start();\n    results.Add(Run(\"S15_Duel_MageHighInt\", sim));\n}\n\n// S16 — Duel hero Front vs enemy Back row\nresults.Add(Run(\"S16_Duel_FrontVsBack\", Duel(\"hero\", \"enemy\", BasicAttack(), BasicAttack(), 1616UL, heroRow: Row.Front, enemyRow: Row.Back)));\n\n// S17 — TeamBattle seed 4001\n{\n    var sim = TestFactory.TeamBattle(out _, out _, seed: 4001UL);\n    results.Add(Run(\"S17_Team4v4_Seed4001\", sim));\n}\n\n// S18 — Hero Air vs enemy Lightning (different element pairing)\nresults.Add(Run(\"S18_Duel_Air_vs_Lightning\", Duel(\"hero\", \"enemy\", BasicAttack(Element.Air), BasicAttack(Element.Lightning), 1818UL, heroElem: Element.Air, enemyElem: Element.Lightning)));\n\n// S19 — Duel seed 1919 (seed kiểm tra ngẫu nhiên crit pattern khác)\nresults.Add(Run(\"S19_Duel_Seed1919\", Duel(\"hero\", \"enemy\", BasicAttack(), BasicAttack(), 1919UL)));\n\n// S20 — TeamBattle seed 5001\n{\n    var sim = TestFactory.TeamBattle(out _, out _, seed: 5001UL);\n    results.Add(Run(\"S20_Team4v4_Seed5001\", sim));\n}\n\n// Output\nvar sb = new StringBuilder();\nforeach (var (label, result, turns, sig) in results)\n    sb.AppendLine($\"[{label}] {result} turns={turns} sig.len={sig.Length}\");\n    \nreturn sb.ToString();\n","safety_checks":true,"compiler":"roslyn"},"error":"Roslyn (Microsoft.CodeAnalysis) is not available. Install it via NuGet or use compiler='codedom'."}
