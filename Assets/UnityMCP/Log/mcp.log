{"ts":"2026-08-13T09:42:47.519Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":935,"action":"execute","params":{"action":"execute","code":"\nvar card = UnityEditor.AssetDatabase.LoadAssetAtPath<GameObject>(\"Assets/_Project/Resources/Prefabs/UI/Widgets/UI_HeroCard.prefab\");\nvar sb = new System.Text.StringBuilder();\nsb.AppendLine(\"Root Image=\" + (card.GetComponent<UnityEngine.UI.Image>()!=null) + \" Button=\" + (card.GetComponent<UnityEngine.UI.Button>()!=null));\nsb.AppendLine(\"Fill Image=\" + (card.transform.Find(\"Fill\").GetComponent<UnityEngine.UI.Image>()!=null));\nvar pr = card.transform.Find(\"PortraitRing\");\nsb.AppendLine(\"PortraitRing Image=\" + (pr.GetComponent<UnityEngine.UI.Image>()!=null) + \" Button=\" + (pr.GetComponent<UnityEngine.UI.Button>()!=null));\nsb.AppendLine(\"PortraitMask/PortraitSprite Image=\" + (pr.Find(\"PortraitMask/PortraitSprite\").GetComponent<UnityEngine.UI.Image>()!=null));\nsb.AppendLine(\"NameLabel Text=\" + (card.transform.Find(\"NameLabel\").GetComponent<UnityEngine.UI.Text>()!=null));\nsb.AppendLine(\"LevelLabel Text=\" + (card.transform.Find(\"LevelLabel\").GetComponent<UnityEngine.UI.Text>()!=null));\nsb.AppendLine(\"GearLabel Text=\" + (card.transform.Find(\"GearLabel\").GetComponent<UnityEngine.UI.Text>()!=null));\nvar tg = card.transform.Find(\"Toggle\");\nsb.AppendLine(\"Toggle Image=\" + (tg.GetComponent<UnityEngine.UI.Image>()!=null) + \" Button=\" + (tg.GetComponent<UnityEngine.UI.Button>()!=null));\nsb.AppendLine(\"Toggle/ToggleLabel Text=\" + (tg.Find(\"ToggleLabel\").GetComponent<UnityEngine.UI.Text>()!=null));\n\nvar row = UnityEditor.AssetDatabase.LoadAssetAtPath<GameObject>(\"Assets/_Project/Resources/Prefabs/UI/Widgets/UI_GearSlotRow.prefab\");\nsb.AppendLine(\"--- GearSlotRow ---\");\nsb.AppendLine(\"SlotNameLabel Text=\" + (row.transform.Find(\"SlotNameLabel\").GetComponent<UnityEngine.UI.Text>()!=null));\nsb.AppendLine(\"ItemLabel Text=\" + (row.transform.Find(\"ItemLabel\").GetComponent<UnityEngine.UI.Text>()!=null));\nsb.AppendLine(\"EquipButton Button=\" + (row.transform.Find(\"EquipButton\").GetComponent<UnityEngine.UI.Button>()!=null) + \" EquipLabel Text=\" + (row.transform.Find(\"EquipButton/EquipLabel\").GetComponent<UnityEngine.UI.Text>()!=null));\nsb.AppendLine(\"EnhanceButton Button=\" + (row.transform.Find(\"EnhanceButton\").GetComponent<UnityEngine.UI.Button>()!=null) + \" Image=\" + (row.transform.Find(\"EnhanceButton\").GetComponent<UnityEngine.UI.Image>()!=null) + \" Label Text=\" + (row.transform.Find(\"EnhanceButton/EnhanceLabel\").GetComponent<UnityEngine.UI.Text>()!=null));\nsb.AppendLine(\"ReforgeButton Button=\" + (row.transform.Find(\"ReforgeButton\").GetComponent<UnityEngine.UI.Button>()!=null) + \" Image=\" + (row.transform.Find(\"ReforgeButton\").GetComponent<UnityEngine.UI.Image>()!=null) + \" Label Text=\" + (row.transform.Find(\"ReforgeButton/ReforgeLabel\").GetComponent<UnityEngine.UI.Text>()!=null));\n\nvar ts = UnityEditor.AssetDatabase.LoadAssetAtPath<GameObject>(\"Assets/_Project/Resources/Prefabs/UI/Screens/UI_TeamSelect.prefab\");\nvar content = ts.transform.Find(\"Panel/Content\");\nsb.AppendLine(\"--- TeamSelect ---\");\nsb.AppendLine(\"BackButton=\" + (content.Find(\"Footer/BackButton\").GetComponent<UnityEngine.UI.Button>()!=null));\nsb.AppendLine(\"StartButton Button=\" + (content.Find(\"Footer/StartButton\").GetComponent<UnityEngine.UI.Button>()!=null) + \" Image=\" + (content.Find(\"Footer/StartButton\").GetComponent<UnityEngine.UI.Image>()!=null));\nsb.AppendLine(\"StartLabel Text=\" + (content.Find(\"Footer/StartButton/StartLabel\").GetComponent<UnityEngine.UI.Text>()!=null));\nsb.AppendLine(\"SelectedLabel Text=\" + (content.Find(\"Footer/SelectedLabel\").GetComponent<UnityEngine.UI.Text>()!=null));\nsb.AppendLine(\"GearTitle Text=\" + (content.Find(\"GearPanelContainer/GearTitle\").GetComponent<UnityEngine.UI.Text>()!=null));\nreturn sb.ToString();\n","safety_checks":true,"compiler":"auto"}}
