{"ts":"2026-08-11T16:15:09.516Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":1253,"action":"execute","params":{"action":"execute","code":"\nvar prefab = UnityEditor.AssetDatabase.LoadAssetAtPath<GameObject>(\"Assets/_Project/Resources/Prefabs/UI/Screens/UI_TeamSelect.prefab\");\nvar canvasGo = new GameObject(\"TmpCanvas\", typeof(RectTransform), typeof(Canvas), typeof(UnityEngine.UI.CanvasScaler), typeof(UnityEngine.UI.GraphicRaycaster));\nvar screenGo = new GameObject(\"TmpScreen\", typeof(RectTransform));\nscreenGo.transform.SetParent(canvasGo.transform, false);\nvar screen = screenGo.AddComponent<Game.Meta.TeamSelectScreen>();\n\n// Gọi private BuildShell() qua reflection để dựng UI mà không cần PlayerProfileDto thật\nvar mi = typeof(Game.Meta.TeamSelectScreen).GetMethod(\"BuildShell\", System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance);\nmi.Invoke(screen, null);\n\nvar root = screenGo.transform.Find(\"UI_TeamSelect(Clone)\");\nvar footer = root.Find(\"Panel/Content/Footer\");\nvar content = root.Find(\"Panel/Content\");\nvar formationRow = content.Find(\"FormationRow\");\nvar startBtn = footer.Find(\"StartButton\").GetComponent<RectTransform>();\nvar backBtn = footer.Find(\"BackButton\").GetComponent<RectTransform>();\n\n// Tính y-range thật trong hệ toạ độ Content (local) bằng world corners quy đổi\nVector3[] frCorners = new Vector3[4];\n((RectTransform)formationRow).GetWorldCorners(frCorners);\nVector3[] sbCorners = new Vector3[4];\nstartBtn.GetWorldCorners(sbCorners);\n\nstring result = $\"FormationRow world Y range: {frCorners[0].y:F1} .. {frCorners[1].y:F1}\\n\" +\n                 $\"StartButton world Y range: {sbCorners[0].y:F1} .. {sbCorners[1].y:F1}\\n\" +\n                 $\"Overlap? {!(frCorners[0].y >= sbCorners[1].y || frCorners[1].y <= sbCorners[0].y)}\";\n\nUnityEngine.Object.DestroyImmediate(canvasGo);\nreturn result;\n","safety_checks":true,"compiler":"auto"}}
