{"ts":"2026-08-11T11:42:35.904Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":1104,"action":"execute","params":{"action":"execute","code":"\nvar asm = System.Array.Find(\n    System.AppDomain.CurrentDomain.GetAssemblies(),\n    a => a.GetName().Name == \"Game.Tests.EditMode\");\nif (asm == null) return \"Assembly not found\";\n\nvar fuzzType = asm.GetType(\"Game.Tests.Combat.FuzzBattleTests\");\nvar detType = asm.GetType(\"Game.Tests.Combat.DeterminismTests\");\nvar sb = new System.Text.StringBuilder();\nif (fuzzType != null)\n    foreach (var m in fuzzType.GetMethods(System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.Instance))\n        if (m.GetCustomAttributes(typeof(NUnit.Framework.TestAttribute), false).Length > 0)\n            sb.AppendLine(\"Fuzz: \" + m.Name);\nif (detType != null)\n    foreach (var m in detType.GetMethods(System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.Instance))\n        if (m.GetCustomAttributes(typeof(NUnit.Framework.TestAttribute), false).Length > 0)\n            sb.AppendLine(\"Det: \" + m.Name);\nreturn sb.ToString();\n","safety_checks":true,"compiler":"auto"}}
