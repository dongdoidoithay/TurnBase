lines.Add(\"S08:\"+Run(sim));}\n{var sim=MkDuel(\"hero\",\"enemy\",9009UL,ba,ba,N,N,10,10,10,10,5,30);lines.Add(\"S09:\"+Run(sim));}\n{var sim=MkDuel(\"hero\",\"enemy\",1010UL,MkPhys(Ea,1f,1,Game.Data.TargetMode.SingleEnemy),ba,Ea,Wi,10,10,10,10,30,30);lines.Add(\"S10:\"+Run(sim));}\n{var sim=Game.Tests.TestFactory.TeamBattle(out _,out _,2001UL);lines.Add(\"S11:\"+Run(sim));}\n{var sim=Game.Tests.TestFactory.TeamBattle(out _,out _,3001UL);lines.Add(\"S12:\"+Run(sim));}\n{var sim=Game.Tests.TestFactory.TeamBattle(out _,out _,4001UL);lines.Add(\"S13:\"+Run(sim));}\n{\n    var sim=new Game.Combat.CombatSimulation(1414UL);\n    var h=new Game.Combat.Model.CombatUnit{DefId=\"hero\",DisplayNameKey=\"hero\",Side=Game.Data.TeamSide.Player,Row=Game.Data.Row.Front,Element=N,Class=Game.Data.HeroClass.Arcanist,PoiseMax=30,BasePrimary=new Game.Data.PrimaryStats(10,10,25,10,10,10)};\n    h.Skills.Add(new Game.Combat.Model.SkillRuntime(MkMag(),0));\n    var e=new Game.Combat.Model.CombatUnit{DefId=\"enemy\",DisplayNameKey=\"enemy\",Side=Game.Data.TeamSide.Enemy,Row=Game.Data.Row.Front,Element=N,Class=Game.Data.HeroClass.Slayer,PoiseMax=30,BasePrimary=new Game.Data.PrimaryStats(10,15,10,10,10,10)};\n    e.Skills.Add(new Game.Combat.Model.SkillRuntime(ba,0));\n    sim.AddUnit(h);sim.AddUnit(e,Game.Tests.TestFactory.SimpleAi());sim.Start();\n    lines.Add(\"S14:\"+Run(sim));\n}\n{\n    var sim=new Game.Combat.CombatSimulation(1515UL);\n    var aoe=MkPhys(N,0.8f,1,Game.Data.TargetMode.AllEnemies);\n    var h=new Game.Combat.Model.CombatUnit{DefId=\"hero\",DisplayNameKey=\"hero\",Side=Game.Data.TeamSide.Player,Row=Game.Data.Row.Front,Element=N,Class=Game.Data.HeroClass.Slayer,PoiseMax=30,BasePrimary=new Game.Data.PrimaryStats(10,10,10,10,10,10)};\n    h.Skills.Add(new Game.Combat.Model.SkillRuntime(aoe,0));\n    var e0=new Game.Combat.Model.CombatUnit{DefId=\"e0\",DisplayNameKey=\"e0\",Side=Game.Data.TeamSide.Enemy,Row=Game.Data.Row.Front,Element=N,Class=Game.Data.HeroClass.Slayer,Pois