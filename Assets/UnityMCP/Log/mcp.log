{"ts":"2026-08-12T20:21:59.749Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":1098,"action":"execute","params":{"action":"execute","code":"string prefabPath = \"Assets/_Project/Resources/Prefabs/UI/Screens/UI_Inventory.prefab\";\nUnityEngine.GameObject prefabObj = UnityEditor.AssetDatabase.LoadAssetAtPath<UnityEngine.GameObject>(prefabPath);\nif (prefabObj == null) return \"Error loading prefab\";\n\nUnityEngine.GameObject instance = (UnityEngine.GameObject)UnityEditor.PrefabUtility.InstantiatePrefab(prefabObj);\n\nfor (int i = instance.transform.childCount - 1; i >= 0; i--) {\n    UnityEngine.GameObject.DestroyImmediate(instance.transform.GetChild(i).gameObject);\n}\n\nUnityEngine.UI.Image rootImg = instance.GetComponent<UnityEngine.UI.Image>();\nif (rootImg == null) rootImg = instance.AddComponent<UnityEngine.UI.Image>();\nUnityEngine.RectTransform rootRt = instance.GetComponent<UnityEngine.RectTransform>();\nrootRt.anchorMin = UnityEngine.Vector2.zero;\nrootRt.anchorMax = UnityEngine.Vector2.one;\nrootRt.offsetMin = UnityEngine.Vector2.zero;\nrootRt.offsetMax = UnityEngine.Vector2.zero;\nrootImg.color = new UnityEngine.Color(0,0,0,0);\n\nUnityEngine.Sprite framePanel = UnityEditor.AssetDatabase.LoadAssetAtPath<UnityEngine.Sprite>(\"Assets/_Project/Art/UI/Frames/frame_panel.png\");\nUnityEngine.Sprite frameSlot = UnityEditor.AssetDatabase.LoadAssetAtPath<UnityEngine.Sprite>(\"Assets/_Project/Art/UI/Frames/frame_slot.png\");\nUnityEngine.Sprite roundedPanel = UnityEditor.AssetDatabase.LoadAssetAtPath<UnityEngine.Sprite>(\"Assets/_Project/Art/UI/Frames/ui_rounded_panel.png\");\n\nUnityEngine.GameObject mainPanelObj = new UnityEngine.GameObject(\"MainPanel\", typeof(UnityEngine.RectTransform), typeof(UnityEngine.UI.Image));\nmainPanelObj.transform.SetParent(instance.transform, false);\nUnityEngine.RectTransform mainRt = mainPanelObj.GetComponent<UnityEngine.RectTransform>();\nmainRt.anchorMin = new UnityEngine.Vector2(0.5f, 0f);\nmainRt.anchorMax = new UnityEngine.Vector2(1f, 1f);\nmainRt.offsetMin = new UnityEngine.Vector2(10, 10);\nmainRt.offsetMax = new UnityEngine.Vector2(-10, -10);\nUnityEngine.UI.Image mainImg = mainPanelObj.GetComponent<UnityEngine.UI.Image>();\nmainImg.sprite = framePanel;\nmainImg.type = UnityEngine.UI.Image.Type.Sliced;\nmainImg.color = new UnityEngine.Color(0.4f, 0.4f, 0.4f, 1f);\n\nUnityEngine.GameObject gridPanel = new UnityEngine.GameObject(\"GridPanel\", typeof(UnityEngine.RectTransform), typeof(UnityEngine.UI.GridLayoutGroup));\ngridPanel.transform.SetParent(mainPanelObj.transform, false);\nUnityEngine.RectTransform gridRt = gridPanel.GetComponent<UnityEngine.RectTransform>();\ngridRt.anchorMin = new UnityEngine.Vector2(0, 0.4f);\ngridRt.anchorMax = new UnityEngine.Vector2(1, 1);\ngridRt.offsetMin = new UnityEngine.Vector2(20, 20);\ngridRt.offsetMax = new UnityEngine.Vector2(-20, -20);\nUnityEngine.UI.GridLayoutGroup grid = gridPanel.GetComponent<UnityEngine.UI.GridLayoutGroup>();\ngrid.cellSize = new UnityEngine.Vector2(80, 80);\ngrid.spacing = new UnityEngine.Vector2(10, 10);\ngrid.childAlignment = UnityEngine.TextAnchor.UpperCenter;\n\nfor(int i=0; i<20; i++) {\n    UnityEngine.GameObject slotObj = new UnityEngine.GameObject(\"Slot_\" + i, typeof(UnityEngine.RectTransform), typeof(UnityEngine.UI.Image));\n    slotObj.transform.SetParent(gridPanel.transform, false);\n    UnityEngine.UI.Image slotImg = slotObj.GetComponent<UnityEngine.UI.Image>();\n    slotImg.sprite = frameSlot;\n    slotImg.type = UnityEngine.UI.Image.Type.Sliced;\n    slotImg.color = new UnityEngine.Color(0.8f, 0.6f, 0.2f, 1f);\n}\n\nUnityEngine.GameObject infoPanel = new UnityEngine.GameObject(\"InfoPanel\", typeof(UnityEngine.RectTransform), typeof(UnityEngine.UI.Image));\ninfoPanel.transform.SetParent(mainPanelObj.transform, false);\nUnityEngine.RectTransform infoRt = infoPanel.GetComponent<UnityEngine.RectTransform>();\ninfoRt.anchorMin = new UnityEngine.Vector2(0, 0.1f); \ninfoRt.anchorMax = new UnityEngine.Vector2(1, 0.4f);\ninfoRt.offsetMin = new UnityEngine.Vector2(20, 20);\ninfoRt.offsetMax = new UnityEngine.Vector2(-20, -20);\nUnityEngine.UI.Image infoImg = infoPanel.GetComponent<UnityEngine.UI.Image>();\ninfoImg.sprite = roundedPanel;\ninfoImg.type = UnityEngine.UI.Image.Type.Sliced;\ninfoImg.color = new UnityEngine.Color(0.1f, 0.1f, 0.2f, 1f);\n\nUnityEngine.GameObject titleObj = new UnityEngine.GameObject(\"TitleText\", typeof(UnityEngine.RectTransform), typeof(TMPro.TextMeshProUGUI));\ntitleObj.transform.SetParent(infoPanel.transform, false);\nUnityEngine.RectTransform titleRt = titleObj.GetComponent<UnityEngine.RectTransform>();\ntitleRt.anchorMin = new UnityEngine.Vector2(0, 0.7f);\ntitleRt.anchorMax = new UnityEngine.Vector2(1, 1);\ntitleRt.offsetMin = new UnityEngine.Vector2(10, 0);\ntitleRt.offsetMax = new UnityEngine.Vector2(-10, 0);\nTMPro.TextMeshProUGUI titleTxt = titleObj.GetComponent<TMPro.TextMeshProUGUI>();\ntitleTxt.text = \"ITEM NAME\";\ntitleTxt.color = UnityEngine.Color.white;\ntitleTxt.alignment = TMPro.TextAlignmentOptions.MidlineLeft;\ntitleTxt.fontSize = 24;\n\nUnityEngine.GameObject actionPanel = new UnityEngine.GameObject(\"ActionPanel\", typeof(UnityEngine.RectTransform), typeof(UnityEngine.UI.HorizontalLayoutGroup));\nactionPanel.transform.SetParent(mainPanelObj.transform, false);\nUnityEngine.RectTransform actionRt = actionPanel.GetComponent<UnityEngine.RectTransform>();\nactionRt.anchorMin = new UnityEngine.Vector2(0, 0);\nactionRt.anchorMax = new UnityEngine.Vector2(1, 0.1f);\nactionRt.offsetMin = new UnityEngine.Vector2(20, 10);\nactionRt.offsetMax = new UnityEngine.Vector2(-20, -10);\nUnityEngine.UI.HorizontalLayoutGroup hLayout = actionPanel.GetComponent<UnityEngine.UI.HorizontalLayoutGroup>();\nhLayout.childAlignment = UnityEngine.TextAnchor.MiddleRight;\nhLayout.childControlHeight = true;\nhLayout.childControlWidth = true;\nhLayout.childForceExpandWidth = false;\nhLayout.spacing = 10;\n\nstring[] buttons = {\"<<\", \"1/3\", \">>\", \"USE\", \"EAT\"};\nforeach(string b in buttons) {\n    UnityEngine.GameObject btnObj = new UnityEngine.GameObject(\"Btn_\" + b, typeof(UnityEngine.RectTransform), typeof(UnityEngine.UI.Image));\n    btnObj.transform.SetParent(actionPanel.transform, false);\n    UnityEngine.UI.Image btnImg = btnObj.GetComponent<UnityEngine.UI.Image>();\n    btnImg.sprite = frameSlot;\n    btnImg.type = UnityEngine.UI.Image.Type.Sliced;\n    btnImg.color = new UnityEngine.Color(0.8f, 0.6f, 0.2f, 1f);\n\n    UnityEngine.GameObject txtObj = new UnityEngine.GameObject(\"Text\", typeof(UnityEngine.RectTransform), typeof(TMPro.TextMeshProUGUI));\n    txtObj.transform.SetParent(btnObj.transform, false);\n    UnityEngine.RectTransform txtRt = txtObj.GetComponent<UnityEngine.RectTransform>();\n    txtRt.anchorMin = UnityEngine.Vector2.zero;\n    txtRt.anchorMax = UnityEngine.Vector2.one;\n    txtRt.offsetMin = new UnityEngine.Vector2(10, 0);\n    txtRt.offsetMax = new UnityEngine.Vector2(-10, 0);\n    TMPro.TextMeshProUGUI btnTxt = txtObj.GetComponent<TMPro.TextMeshProUGUI>();\n    btnTxt.text = b;\n    btnTxt.color = UnityEngine.Color.white;\n    btnTxt.alignment = TMPro.TextAlignmentOptions.Center;\n}\n\nUnityEditor.PrefabUtility.SaveAsPrefabAsset(instance, prefabPath);\nUnityEngine.GameObject.DestroyImmediate(instance);\nreturn \"Built UI_Inventory layout successfully!\";","safety_checks":true,"compiler":"auto"}}
