,26));\n    MakeText(nameGo, \"Item\", 12, TextAnchor.MiddleLeft, Color.white);\n\n    var btnGo = new GameObject(\"BuyButton\", typeof(RectTransform));\n    btnGo.transform.SetParent(row.transform, false);\n    MakeRT(btnGo, new Vector2(1,0.5f), new Vector2(1,0.5f), new Vector2(1,0.5f), new Vector2(-4,0), new Vector2(62,26));\n    MakePanelImage(btnGo, new Color(0.271f,0.482f,0.616f,0.95f));\n    btnGo.AddComponent<UnityEngine.UI.Button>();\n    var labelGo = new GameObject(\"Label\", typeof(RectTransform));\n    labelGo.transform.SetParent(btnGo.transform, false);\n    MakeRT(labelGo, Vector2.zero, Vector2.one, new Vector2(0.5f,0.5f), Vector2.zero, Vector2.zero);\n    MakeText(labelGo, \"0\", 9, TextAnchor.MiddleCenter, Color.white);\n\n    return row;\n};\n\nvar root = new GameObject(\"UI_Shop\", typeof(RectTransform));\nvar canvas = root.AddComponent<Canvas>();\ncanvas.renderMode = RenderMode.ScreenSpaceOverlay;\ncanvas.sortingOrder = 300;\nvar scaler = root.AddComponent<UnityEngine.UI.CanvasScaler>();\nscaler.uiScaleMode = UnityEngine.UI.CanvasScaler.ScaleMode.ScaleWithScreenSize;\nscaler.referenceResolution = new Vector2(960, 540);\nscaler.matchWidthOrHeight = 0.5f;\nroot.AddComponent<UnityEngine.UI.GraphicRaycaster>();\n\nvar dim = new GameObject(\"Dim\", typeof(RectTransform));\ndim.transform.SetParent(root.transform, false);\nMakeRT(dim, Vector2.zero, Vector2.one, new Vector2(0.5f,0.5f), Vector2.zero, Vector2.zero);\ndim.AddComponent<UnityEngine.UI.Image>().color = new Color(0,0,0,0.65f);\n\nvar panel = new GameObject(\"Panel\", typeof(RectTransform));\npanel.transform.SetParent(root.transform, false);\nMakeRT(panel, new Vector2(0.5f,0.5f), new Vector2(0.5f,0.5f), new Vector2(0.5f,0.5f), Vector2.zero, new Vector2(620,420));\nMakePanelImage(panel, new Color(0.957f,0.635f,0.349f,1f));\n\nvar fill = new GameObject(\"Fill\", typeof(RectTransform));\nfill.transform.SetParent(panel.transform, false);\nMakeRT(fill, Vector2.zero, Vector2.one, new Vector2(0.5f,0.5f), Vector2.zero, new Vector2(-24,-24));\nMakePanelImage(fill, new Color(0.114f,0.078f,0.129f,0.98f));\n\nvar title = new GameObject(\"Title\", typeof(RectTransform));\ntitle.transform.SetParent(panel.transform, false);\nMakeRT(title, new Vector2(0.5f,1f), new Vector2(0.5f,1f), new Vector2(0.5f,1f), new Vector2(0,-16), new Vector2(500,30));\nMakeText(title, \"SHOP\", 20, TextAnchor.MiddleCenter, new Color(1f,0.85f,0.5f,1f));\n\nvar wallet = new GameObject(\"WalletLabel\", typeof(RectTransform));\nwallet.transform.SetParent(panel.transform, false);\nMakeRT(wallet, new Vector2(0,1), new Vector2(0,1), new Vector2(0,1), new Vector2(150,-70), new Vector2(200,26));\nMakeText(wallet, \"\", 16, TextAnchor.MiddleLeft, Color.white);\n\nvar close = new GameObject(\"CloseButton\", typeof(RectTransform));\nclose.transform.SetParent(panel.transform, false);\nMakeRT(close, new Vector2(0.5f,0f), new Vector2(0.5f,0f), new Vector2(0.5f,0f), new Vector2(0,16), new Vector2(140,36));\nMakePanelImage(close, new Color(0.32f,0.29f,0.33f,1f));\nclose.AddComponent<UnityEngine.UI.Button>();\nvar closeLabel = new GameObject(\"Label\", typeof(RectTransform));\ncloseLabel.transform.SetParent(close.transform, false);\nMakeRT(closeLabel, Vector2.zero, Vector2.one, new Vector2(0.5f,0.5f), Vector2.zero, Vector2.zero);\nMakeText(closeLabel, \"CLOSE\", 14, TextAnchor.MiddleCenter, Color.white);\n\nvar list = new GameObject(\"RowListContainer\", typeof(RectTransform));\nlist.transform.SetParent(panel.transform, false);\nMakeRT(list, new Vector2(0,1), new Vector2(0,1), new Vector2(0,1), new Vector2(260,-110), new Vector2(330,170));\n\nfor (int i = 0; i < 10; i++) BuildShopRow(list.transform, i, -34f * i);\n\nvar path = \"Assets/_Project/Resources/Prefabs/UI/Screens/UI_Shop.prefab\";\nUnityEditor.PrefabUtility.SaveAsPrefabAsset(root, path);\nUnityEngine.Object.DestroyImmediate(root);\nreturn \"UI_Shop saved, 10 rows\";\n","safety_checks":true,"compiler":"auto"}}
