{"ts":"2026-08-13T09:43:22.986Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":939,"action":"execute","params":{"action":"execute","code":"\nvar hd = UnityEditor.AssetDatabase.LoadAssetAtPath<GameObject>(\"Assets/_Project/Resources/Prefabs/UI/Screens/UI_HeroDetail.prefab\");\nvar panel = hd.transform.Find(\"Panel\");\nvar sb = new System.Text.StringBuilder();\nsb.AppendLine(\"Title Text=\" + (panel.Find(\"Title\").GetComponent<UnityEngine.UI.Text>()!=null));\nsb.AppendLine(\"LevelLabel Text=\" + (panel.Find(\"LevelLabel\").GetComponent<UnityEngine.UI.Text>()!=null));\nsb.AppendLine(\"ExpBar/ExpLabel Text=\" + (panel.Find(\"ExpBar/ExpLabel\").GetComponent<UnityEngine.UI.Text>()!=null));\nsb.AppendLine(\"ExpBar/Fill Image=\" + (panel.Find(\"ExpBar/Fill\").GetComponent<UnityEngine.UI.Image>()!=null));\nsb.AppendLine(\"Portrait Image=\" + (panel.Find(\"PortraitFrame/PortraitMask/PortraitSprite\").GetComponent<UnityEngine.UI.Image>()!=null));\nstring[] stats = {\"STR\",\"CON\",\"INT\",\"DEX\",\"AUR\",\"LUK\"};\nforeach (var s in stats) sb.AppendLine(\"Stat \"+s+\" Value Text=\" + (panel.Find(\"StatsContainer/Row_\"+s+\"/Value\").GetComponent<UnityEngine.UI.Text>()!=null));\nfor (int i=0;i<5;i++)\n{\n    var row = panel.Find(\"SkillListContainer/Row_\"+i);\n    sb.AppendLine(\"Skill\"+i+\" NameLabel=\"+ (row.Find(\"NameLabel\").GetComponent<UnityEngine.UI.Text>()!=null)\n        + \" LevelLabel=\"+(row.Find(\"LevelLabel\").GetComponent<UnityEngine.UI.Text>()!=null)\n        + \" UpgradeButton=\"+(row.Find(\"UpgradeButton\").GetComponent<UnityEngine.UI.Button>()!=null)\n        + \" UpgradeButton/Label=\"+(row.Find(\"UpgradeButton/Label\").GetComponent<UnityEngine.UI.Text>()!=null));\n}\nsb.AppendLine(\"AscendButton Button=\"+(panel.Find(\"AscendButton\").GetComponent<UnityEngine.UI.Button>()!=null)+\" Image=\"+(panel.Find(\"AscendButton\").GetComponent<UnityEngine.UI.Image>()!=null));\nsb.AppendLine(\"AscendButton/Label Text=\"+(panel.Find(\"AscendButton/Label\").GetComponent<UnityEngine.UI.Text>()!=null));\nsb.AppendLine(\"CloseButton Button=\"+(panel.Find(\"CloseButton\").GetComponent<UnityEngine.UI.Button>()!=null));\nreturn sb.ToString();\n","safety_checks":true,"compiler":"auto"}}
