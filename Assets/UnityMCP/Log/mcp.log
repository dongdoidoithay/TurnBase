{"ts":"2026-08-12T04:57:08.070Z","tool":"execute_code","type":"tool","status":"SUCCESS","ms":982,"action":"execute","params":{"action":"execute","code":"var titleLabelGo = GameObject.Find(\"GameBootstrap/__UI__/UIRoot/TitleCanvas/TitleLabel\");\nvar rt = (RectTransform)titleLabelGo.transform;\nvar switcher = titleLabelGo.GetComponent<Game.Core.UI.LayoutProfileSwitcher>();\n\nvar landscape = Game.Core.UI.LayoutProfile.CaptureFrom(rt, \"TitleLabel_Landscape\");\nvar portrait = landscape;\nportrait.Name = \"TitleLabel_Portrait\";\nportrait.SizeDelta = new Vector2(460f, 70f);\n\nswitcher.SetProfiles(rt, portrait, landscape);\n\nUnityEditor.EditorUtility.SetDirty(switcher);\nUnityEditor.SceneManagement.EditorSceneManager.MarkSceneDirty(titleLabelGo.scene);\n\nreturn \"landscape=\" + landscape.SizeDelta + \" portrait=\" + portrait.SizeDelta + \" rt.sizeDelta(after)=\" + rt.sizeDelta;","safety_checks":true,"compiler":"auto"}}
